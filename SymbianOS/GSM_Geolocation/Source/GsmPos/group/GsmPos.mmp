LANG 01 27

#ifdef ENABLE_ABIV2_MODE
DEBUGGABLE_UDEBONLY
#endif

SOURCEPATH ..\src

SOURCE GsmPosContainerView.cpp
SOURCE GsmPosContainer.cpp
SOURCE GsmPosDocument.cpp
SOURCE GsmPosApplication.cpp
SOURCE GsmPosAppUi.cpp
SOURCE GsmPosLogger.cpp 
SOURCE GsmPosEngine.cpp 
SOURCE GsmPosCellIdMonitor.cpp 
SOURCE GsmPosGpsMonitor.cpp
SOURCE GsmPosDatabase.cpp 
SOURCE GsmPosWebClient.cpp 
SOURCE GsmPosImageFormatDecoder.cpp
SOURCE GsmPosListBoxMarkableDialog.cpp 
SOURCE GsmPosBluetooth.cpp
SOURCE GsmPosBluetoothRxSocket.cpp 
SOURCE GsmPosGoogleMap.cpp 
SOURCE GsmPosMap.cpp

CAPABILITY LocalServices Location NetworkServices ReadDeviceData ReadUserData WriteDeviceData WriteUserData
