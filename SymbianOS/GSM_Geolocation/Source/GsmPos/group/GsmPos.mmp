LIBRARY libopunion.lib
LIBRARY libopvalid.lib
LIBRARY libplanargraph.lib
LIBRARY libprecision.lib
LIBRARY libsimplify.lib
LIBRARY libsnapround.lib
LIBRARY libutil.lib
