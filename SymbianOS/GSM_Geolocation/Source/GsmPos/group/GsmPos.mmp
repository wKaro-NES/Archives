STATICLIBRARY libopdistance.lib
STATICLIBRARY liboperation.lib
STATICLIBRARY liboplinemerge.lib
STATICLIBRARY libopoverlay.lib
STATICLIBRARY liboppolygonize.lib
STATICLIBRARY liboppredicate.lib
STATICLIBRARY liboprelate.lib
STATICLIBRARY libopunion.lib
STATICLIBRARY libopvalid.lib
STATICLIBRARY libplanargraph.lib
STATICLIBRARY libprecision.lib
STATICLIBRARY libsimplify.lib
STATICLIBRARY libsnapround.lib
