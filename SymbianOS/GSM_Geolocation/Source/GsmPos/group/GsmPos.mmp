
TARGET GsmPos.exe
UID 0x100039CE 0xE8385A69
VENDORID 0
TARGETTYPE exe
EPOCSTACKSIZE 0x8000
//min 1MB max:8MB
EPOCHEAPSIZE 0x100000 0x800000

SYSTEMINCLUDE \epoc32\include 
SYSTEMINCLUDE \epoc32\include\variant 
SYSTEMINCLUDE \epoc32\include\ecom
//Open C++
SYSTEMINCLUDE   \epoc32\include\stdapis
SYSTEMINCLUDE   \epoc32\include\stdapis\sys
SYSTEMINCLUDE   \epoc32\include\stdapis\stlport 

//Ported: geos-3.1.1
SYSTEMINCLUDE ..\..\Geos\geos\headers

USERINCLUDE	..\inc
USERINCLUDE ..\data

SOURCEPATH ..\data
START RESOURCE	GsmPos.rss
HEADER
TARGETPATH resource\apps
END //RESOURCE

START RESOURCE	GsmPos_reg.rss
TARGETPATH 	  \private\10003a3f\apps
END //RESOURCE

//Open C++
//standard E32Main() not main()
//STATICLIBRARY  libcrt0.lib
LIBRARY libc.lib 
#ifdef EPOC32
LIBRARY  libstdcpp.lib
#else
FIRSTLIB ../udeb/libstdcpp.lib
STATICLIBRARY    eexe.lib 
#endif
//This is required even if the wchar type is not used.
OPTION CW -wchar_t on 
MACRO  _WCHAR_T_DECLARED

//Standard Symbian libs
LIBRARY	euser.lib apparc.lib cone.lib eikcore.lib avkon.lib
LIBRARY	commonengine.lib efsrv.lib estor.lib eikcoctl.lib eikdlg.lib 
LIBRARY	eikctl.lib bafl.lib fbscli.lib aknnotify.lib aknicon.lib
LIBRARY	etext.lib gdi.lib egul.lib insock.lib
LIBRARY	ecom.lib InetProtUtil.lib http.lib esock.lib
LIBRARY flogger.lib
LIBRARY etel3rdparty.lib
LIBRARY lbs.lib eposlandmarks.lib satinfo.lib
LIBRARY edbms.lib 
LIBRARY imageconversion.lib
LIBRARY bluetooth.lib btextnotifiers.lib btdevice.lib 
LIBRARY bitgdi.lib

//Ported: geos-3.1.1 libs
LIBRARY libm.lib
#ifdef EPOC32
STATICLIBRARY libalgorithm.lib
STATICLIBRARY liblocation.lib
STATICLIBRARY libgeom.lib
STATICLIBRARY libgeomgraph.lib
STATICLIBRARY libgeomgraphindex.lib
STATICLIBRARY libgeomprep.lib
STATICLIBRARY libgeomutil.lib
STATICLIBRARY libgeos.lib
