#else
LIBRARY libalgorithm.lib
LIBRARY liblocation.lib
LIBRARY libgeom.lib
LIBRARY libgeomgraph.lib
LIBRARY libgeomgraphindex.lib
LIBRARY libgeomprep.lib
LIBRARY libgeomutil.lib
LIBRARY libgeos.lib
LIBRARY libindexbintree.lib
LIBRARY libindexchain.lib
LIBRARY libindexquadtree.lib
LIBRARY libindexstrtree.lib
LIBRARY libindexsweepline.lib
LIBRARY libintervalrtree.lib
LIBRARY libio.lib
LIBRARY libnoding.lib
LIBRARY libopbuffer.lib
LIBRARY libopdistance.lib
LIBRARY liboperation.lib
LIBRARY liboplinemerge.lib
LIBRARY libopoverlay.lib
LIBRARY liboppolygonize.lib
LIBRARY liboppredicate.lib
