
TARGET			GsmPosRemote.exe
UID			   0x100039CE 0xE50E7AC1
VENDORID	  	  0
TARGETTYPE		exe
EPOCSTACKSIZE	 0x5000

SYSTEMINCLUDE \epoc32\include \epoc32\include\variant \epoc32\include\ecom
USERINCLUDE	   ..\inc
USERINCLUDE    ..\data
USERINCLUDE    ..\..\GsmPos\inc

SOURCEPATH		..\data
START RESOURCE	GsmPosRemote.rss
HEADER
TARGETPATH resource\apps
END //RESOURCE

START RESOURCE	GsmPosRemote_reg.rss
TARGETPATH 	  \private\10003a3f\apps
END //RESOURCE

LIBRARY			euser.lib apparc.lib cone.lib eikcore.lib avkon.lib
LIBRARY			commonengine.lib efsrv.lib estor.lib eikcoctl.lib eikdlg.lib 
LIBRARY			eikctl.lib bafl.lib fbscli.lib aknnotify.lib aknicon.lib
LIBRARY			etext.lib gdi.lib egul.lib insock.lib
LIBRARY			ecom.lib InetProtUtil.lib http.lib esock.lib
LIBRARY flogger.lib
LIBRARY etel3rdparty.lib
LIBRARY bluetooth.lib btextnotifiers.lib btdevice.lib 

//TODO  LANG 27
LANG 				01

#ifdef ENABLE_ABIV2_MODE
DEBUGGABLE_UDEBONLY
#endif


SOURCEPATH		..\src

SOURCE GsmPosRemoteContainer.cpp
SOURCE GsmPosRemoteAppUi.cpp
SOURCE GsmPosRemoteApplication.cpp
SOURCE GsmPosRemoteDocument.cpp
SOURCE GsmPosRemoteEngine.cpp

SOURCEPATH		..\..\GsmPos\src

SOURCE GsmPosLogger.cpp
SOURCE GsmPosCellIdMonitor.cpp
SOURCE GsmPosBluetooth.cpp
SOURCE GsmPosBluetoothRxSocket.cpp

CAPABILITY LocalServices NetworkServices ReadDeviceData ReadUserData WriteDeviceData WriteUserData
