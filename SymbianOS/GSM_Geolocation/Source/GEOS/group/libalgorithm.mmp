TARGET		  libalgorithm.lib
TARGETTYPE	  stdlib 
UID			 0x0 0x0

SYSTEMINCLUDE   \epoc32\include

#ifdef ENABLE_ABIV2_MODE
  DEBUGGABLE_UDEBONLY
#endif


//Open C++
SYSTEMINCLUDE   \epoc32\include\stdapis
SYSTEMINCLUDE   \epoc32\include\stdapis\sys
SYSTEMINCLUDE   \epoc32\include\stdapis\stlport 

//Open C++
//standard E32Main() not main()
STATICLIBRARY  libcrt0.lib
LIBRARY libc.lib 
#ifdef EPOC32
LIBRARY  libstdcpp.lib
#else
FIRSTLIB ../udeb/libstdcpp.lib
STATICLIBRARY    eexe.lib 
#endif

LIBRARY       euser.lib

//This is required even if the wchar type is not used.
OPTION CW -wchar_t on 
MACRO  _WCHAR_T_DECLARED

/*
Ported: geos-3.1.1
*/
SYSTEMINCLUDE ..\geos\headers

SOURCEPATH ..\geos\algorithm
SOURCE		CentroidArea.cpp
SOURCE		CentroidLine.cpp
SOURCE		CentroidPoint.cpp
SOURCE		CGAlgorithms.cpp
SOURCE		ConvexHull.cpp
SOURCE		HCoordinate.cpp
SOURCE		InteriorPointArea.cpp
SOURCE		InteriorPointLine.cpp
SOURCE		InteriorPointPoint.cpp
SOURCE		LineIntersector.cpp
SOURCE		MCPointInRing.cpp
SOURCE		MinimumDiameter.cpp
SOURCE		NotRepresentableException.cpp
SOURCE		PointLocator.cpp
SOURCE		RayCrossingCounter.cpp
SOURCE		RobustDeterminant.cpp
SOURCE		SimplePointInRing.cpp
SOURCE		SIRtreePointInRing.cpp

SOURCEPATH ..\src
SOURCE		DLL.cpp
