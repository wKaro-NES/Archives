TARGET		  libnoding.lib
TARGETTYPE	  stdlib 
UID			 0x0 0x0

SYSTEMINCLUDE   \epoc32\include

#ifdef ENABLE_ABIV2_MODE
  DEBUGGABLE_UDEBONLY
#endif


//Open C++
SYSTEMINCLUDE   \epoc32\include\stdapis
SYSTEMINCLUDE   \epoc32\include\stdapis\sys
SYSTEMINCLUDE   \epoc32\include\stdapis\stlport 

//Open C++
//standard E32Main() not main()
STATICLIBRARY  libcrt0.lib
LIBRARY libc.lib 
#ifdef EPOC32
LIBRARY  libstdcpp.lib
#else
FIRSTLIB ../udeb/libstdcpp.lib
STATICLIBRARY    eexe.lib 
#endif

LIBRARY       euser.lib

//This is required even if the wchar type is not used.
OPTION CW -wchar_t on 
MACRO  _WCHAR_T_DECLARED

/*
Ported: geos-3.1.1
*/
SYSTEMINCLUDE ..\geos\headers

SOURCEPATH ..\geos\noding	
SOURCE		FastNodingValidator.cpp
SOURCE		FastSegmentSetIntersectionFinder.cpp
SOURCE		IntersectionAdder.cpp
SOURCE		IntersectionFinderAdder.cpp
SOURCE		IteratedNoder.cpp
SOURCE		MCIndexNoder.cpp
SOURCE		MCIndexSegmentSetMutualIntersector.cpp
SOURCE		NodedSegmentString.cpp
SOURCE		NodingValidator.cpp
SOURCE		Octant.cpp
SOURCE		ScaledNoder.cpp
SOURCE		SegmentIntersectionDetector.cpp
SOURCE		SegmentNode.cpp
SOURCE		SegmentNodeList.cpp
SOURCE		SegmentString.cpp
SOURCE		SegmentStringUtil.cpp
SOURCE		SimpleNoder.cpp
SOURCE		SingleInteriorIntersectionFinder.cpp
	

SOURCEPATH ..\src
SOURCE		DLL.cpp
