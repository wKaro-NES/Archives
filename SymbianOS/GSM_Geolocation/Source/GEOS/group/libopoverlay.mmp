TARGET		  libopoverlay.lib
TARGETTYPE	  stdlib 
UID			 0x0 0x0

SYSTEMINCLUDE   \epoc32\include

#ifdef ENABLE_ABIV2_MODE
  DEBUGGABLE_UDEBONLY
#endif


//Open C++
SYSTEMINCLUDE   \epoc32\include\stdapis
SYSTEMINCLUDE   \epoc32\include\stdapis\sys
SYSTEMINCLUDE   \epoc32\include\stdapis\stlport 

//Open C++
//standard E32Main() not main()
STATICLIBRARY  libcrt0.lib
LIBRARY libc.lib 
#ifdef EPOC32
LIBRARY  libstdcpp.lib
#else
FIRSTLIB ../udeb/libstdcpp.lib
STATICLIBRARY    eexe.lib 
#endif

LIBRARY       euser.lib

//This is required even if the wchar type is not used.
OPTION CW -wchar_t on 
MACRO  _WCHAR_T_DECLARED

/*
Ported: geos-3.1.1
*/
SYSTEMINCLUDE ..\geos\headers
	
SOURCEPATH ..\geos\operation\overlay	
SOURCE		EdgeSetNoder.cpp
SOURCE		ElevationMatrix.cpp
SOURCE		ElevationMatrixCell.cpp
SOURCE		FuzzyPointLocator.cpp
SOURCE		LineBuilder.cpp
SOURCE		MaximalEdgeRing.cpp
SOURCE		MinimalEdgeRing.cpp
SOURCE		OffsetPointGenerator.cpp
SOURCE		OverlayNodeFactory.cpp
SOURCE		OverlayOp.cpp
SOURCE		OverlayResultValidator.cpp
SOURCE		PointBuilder.cpp
SOURCE		PolygonBuilder.cpp

SOURCEPATH ..\src
SOURCE		DLL.cpp
