TARGET		  Geos.exe
TARGETTYPE	  exe
UID			 0 0xE27FFF17

SYSTEMINCLUDE   \epoc32\include

#ifdef ENABLE_ABIV2_MODE
  DEBUGGABLE_UDEBONLY
#endif


//Open C++
SYSTEMINCLUDE   \epoc32\include\stdapis
SYSTEMINCLUDE   \epoc32\include\stdapis\sys
SYSTEMINCLUDE   \epoc32\include\stdapis\stlport 

//Open C++
//standard E32Main() not main()
STATICLIBRARY  libcrt0.lib
LIBRARY libc.lib 
#ifdef EPOC32
LIBRARY  libstdcpp.lib
#else
FIRSTLIB ../udeb/libstdcpp.lib
STATICLIBRARY    eexe.lib 
#endif

LIBRARY euser.lib

//This is required even if the wchar type is not used.
OPTION CW -wchar_t on 
MACRO  _WCHAR_T_DECLARED

LANG 01

//Resources
SOURCEPATH		..\data
START RESOURCE	Geos.rss
HEADER
TARGETPATH resource\apps
END //RESOURCE

START RESOURCE	Geos_reg.rss
TARGETPATH 	  \private\10003a3f\apps
END //RESOURCE


/*
Ported: geos-3.1.1
*/
SYSTEMINCLUDE ..\geos\headers

//SOURCEPATH ..\src
//SOURCE 		Geos.cpp

//min 1MB max:8MB
EPOCHEAPSIZE 0x100000 0x800000
 
//TODO FIXME WK - speed test
//SOURCEPATH ..\tests\bigtest
//SOURCE GeometryTestFactory.cpp
//SOURCE TestSweepLineSpeed.cpp

//Unit Tests

SYSTEMINCLUDE ..\geos\capi
SYSTEMINCLUDE ..\tests\tut
SYSTEMINCLUDE ..\tests\unit

SOURCEPATH ..\tests\unit
SOURCE  geos_unit.cpp

